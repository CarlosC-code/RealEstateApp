@model List<RealEstateApp.Core.Application.Dtos.Offer.OfferDto>

@{
    ViewData["Title"] = "Mis Ofertas";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h2><i class="fas fa-tag me-2"></i>Mis Ofertas</h2>
    <a asp-action="Index" class="btn btn-secondary">
        <i class="fas fa-arrow-left me-1"></i>Volver
    </a>
</div>

@if (Model == null || !Model.Any())
{
        <div class="text-center mt-5">
            <i class="fas fa-tag fa-5x text-muted mb-3"></i>
            <h4 class="text-muted">No tienes ofertas realizadas</h4>
        </div>
}
else
{
        <div class="card shadow">
            <div class="card-body">
                <table class="table table-hover">
                    <thead class="table-dark">
                        <tr>
                            <th>Propiedad</th>
                            <th>Monto</th>
                            <th>Fecha</th>
                            <th>Estado</th>
                        </tr>
                    </thead>
                    <tbody>
                    @foreach (var offer in Model)
                    {
                                <tr>
                                    <td>Propiedad #@offer.PropertyId</td>
                                    <td>RD$ @offer.Amount.ToString("N2")</td>
                                    <td>@offer.OfferDate.ToString("dd/MM/yyyy hh:mm tt")</td>
                                    <td>
                                        <span class="badge @(offer.Status == "Accepted" ? "bg-success" : offer.Status == "Rejected" ? "bg-danger" : "bg-warning")">
                                    @(offer.Status == "Accepted" ? "Aceptada" : offer.Status == "Rejected" ? "Rechazada" : "Pendiente")
                                        </span>
                                    </td>
                                </tr>
                    }
                    </tbody>
                </table>
            </div>
        </div>
}