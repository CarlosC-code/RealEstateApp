@model RealEstateApp.Core.Application.Dtos.Property.PropertyDto
@{
    ViewData["Title"] = "Detalle de propiedad";
}
<div class="row">
    <div class="col-md-8">
        @if (Model.Images != null && Model.Images.Any())
        {
            <div id="propertyCarousel" class="carousel slide mb-4" data-bs-ride="carousel">
                <div class="carousel-inner">
                    @for (int i = 0; i < Model.Images.Count; i++)
                    {
                        <div class="carousel-item @(i == 0 ? "active" : "")">
                            <img src="@Model.Images[i]" class="d-block w-100" style="height:400px;object-fit:cover;" alt="Imagen @(i+1)" />
                        </div>
                    }
                </div>
                <button class="carousel-control-prev" type="button" data-bs-target="#propertyCarousel" data-bs-slide="prev">
                    <span class="carousel-control-prev-icon"></span>
                </button>
                <button class="carousel-control-next" type="button" data-bs-target="#propertyCarousel" data-bs-slide="next">
                    <span class="carousel-control-next-icon"></span>
                </button>
            </div>
        }
        <div class="card shadow-sm mb-4">
            <div class="card-body">
                <div class="d-flex gap-2 mb-3">
                    <span class="badge bg-primary">@Model.PropertyTypeName</span>
                    <span class="badge bg-success">@Model.SaleTypeName</span>
                    <span class="badge bg-secondary">Código: @Model.Code</span>
                </div>
                <h3 class="text-primary">RD$ @Model.Price.ToString("N2")</h3>
                <div class="d-flex gap-4 text-muted my-3">
                    <span><i class="fas fa-bed me-1"></i>@Model.Bedrooms habitaciones</span>
                    <span><i class="fas fa-bath me-1"></i>@Model.Bathrooms baños</span>
                    <span><i class="fas fa-ruler-combined me-1"></i>@Model.LandSize mt²</span>
                </div>
                <h5>Descripción</h5>
                <p>@Model.Description</p>
                @if (Model.Improvements != null && Model.Improvements.Any())
                {
                    <h5>Mejoras</h5>
                    <div class="d-flex flex-wrap gap-2">
                        @foreach (var improvement in Model.Improvements)
                        {
                            <span class="badge bg-light text-dark border">
                                <i class="fas fa-check-circle text-success me-1"></i>@improvement
                            </span>
                        }
                    </div>
                }
            </div>
        </div>
    </div>

    <div class="col-md-4">
        <div class="card shadow-sm mb-4">
            <div class="card-body text-center">
                @if (ViewBag.Agent != null && !string.IsNullOrEmpty(ViewBag.Agent.PhotoUrl))
                {
                    <img src="@ViewBag.Agent.PhotoUrl" class="rounded-circle mb-3"
                         style="width:80px;height:80px;object-fit:cover;" alt="Agente" />
                }
                else
                {
                    <i class="fas fa-user-circle fa-4x text-primary mb-3"></i>
                }
                <h5>Agente Inmobiliario</h5>
                @if (ViewBag.Agent != null)
                {
                    <p class="text-muted mb-1 fw-bold">@ViewBag.Agent.FullName</p>
                    <p class="text-muted mb-1">
                        <i class="fas fa-phone me-1"></i>@ViewBag.Agent.Phone
                    </p>
                    <p class="text-muted mb-0">
                        <i class="fas fa-envelope me-1"></i>@ViewBag.Agent.Email
                    </p>
                }
            </div>
        </div>

        @if (User.IsInRole("Agent"))
        {
            <div class="card shadow-sm mb-4">
                <div class="card-header bg-primary text-white">
                    <i class="fas fa-comments me-2"></i>Chats con Clientes
                </div>
                <div class="card-body">
                    @if (ViewBag.ChatClients != null && ((IEnumerable<dynamic>)ViewBag.ChatClients).Any())
                    {
                        <div class="list-group">
                            @foreach (var client in ViewBag.ChatClients)
                            {
                                <a asp-controller="Agent" asp-action="ChatWithClient"
                                   asp-route-propertyId="@ViewBag.PropertyId"
                                   asp-route-clientId="@client.ClientId"
                                   class="list-group-item list-group-item-action">
                                    <i class="fas fa-user me-2"></i>@client.ClientName
                                </a>
                            }
                        </div>
                    }
                    else
                    {
                        <p class="text-muted text-center mb-0">No hay conversaciones aún</p>
                    }
                </div>
            </div>

            <div class="card shadow-sm mb-4">
                <div class="card-header bg-warning text-white">
                    <i class="fas fa-tag me-2"></i>Gestión de Ofertas
                </div>
                <div class="card-body text-center">
                    <a asp-controller="Agent" asp-action="Offers" asp-route-propertyId="@Model.Id"
                       class="btn btn-warning w-100">
                        <i class="fas fa-tag me-1"></i>Ver Ofertas
                    </a>
                </div>
            </div>
        }

        @if (User.IsInRole("Client"))
        {
            <div class="card shadow-sm mb-4">
                <div class="card-header bg-primary text-white">
                    <i class="fas fa-comments me-2"></i>Chat con el agente
                </div>
                <div class="card-body p-2">
                    <div style="height:250px;overflow-y:auto;" class="mb-2 p-2" id="chatBox">
                        @if (ViewBag.ChatMessages != null)
                        {
                            @foreach (var msg in ViewBag.ChatMessages)
                            {
                                <div class="d-flex @(msg.IsFromClient ? "justify-content-end" : "justify-content-start") mb-2">
                                    <div class="p-2 rounded @(msg.IsFromClient ? "bg-primary text-white" : "bg-light")"
                                         style="max-width:80%;font-size:0.85rem;">
                                        <p class="mb-0">@msg.Message</p>
                                        <small class="@(msg.IsFromClient ? "text-white-50" : "text-muted")">
                                            @msg.SentAt.ToString("hh:mm tt")
                                        </small>
                                    </div>
                                </div>
                            }
                        }
                    </div>
                    <form asp-action="SendMessage" method="post">
                        <input type="hidden" name="propertyId" value="@Model.Id" />
                        <input type="hidden" name="agentId" value="@ViewBag.AgentId" />
                        <div class="input-group">
                            <input type="text" name="message" class="form-control form-control-sm"
                                   placeholder="Escribe un mensaje..." required />
                            <button type="submit" class="btn btn-primary btn-sm">
                                <i class="fas fa-paper-plane"></i>
                            </button>
                        </div>
                    </form>
                </div>
            </div>

            <div class="card shadow-sm">
                <div class="card-header bg-success text-white">
                    <i class="fas fa-tag me-2"></i>Ofertas
                </div>
                <div class="card-body">
                    @{
                        var clientOffers = ViewBag.ClientOffers as List<RealEstateApp.Core.Application.Dtos.Offer.OfferDto>;
                        bool hasPending = clientOffers != null && clientOffers.Any(o => o.Status == "Pending");
                        bool hasAccepted = ViewBag.HasAcceptedOffer == true;
                        bool canOffer = !hasPending && !hasAccepted;
                    }

                    <button type="button" class="btn btn-success w-100 mb-3"
                            data-bs-toggle="modal" data-bs-target="#offerModal"
                    @(!canOffer ? "disabled" : "")>
                        <i class="fas fa-plus me-1"></i>Nueva Oferta
                    </button>

                    @if (clientOffers != null && clientOffers.Any())
                    {
                        <table class="table table-sm">
                            <thead>
                                <tr>
                                    <th>Fecha</th>
                                    <th>Monto</th>
                                    <th>Estado</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var offer in clientOffers)
                                {
                                    <tr>
                                        <td>@offer.OfferDate.ToString("dd/MM/yyyy")</td>
                                        <td>RD$ @offer.Amount.ToString("N2")</td>
                                        <td>
                                            <span class="badge @(offer.Status == "Accepted" ? "bg-success" : offer.Status == "Rejected" ? "bg-danger" : "bg-warning")">
                                                @(offer.Status == "Accepted" ? "Aceptada" : offer.Status == "Rejected" ? "Rechazada" : "Pendiente")
                                            </span>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    }
                    else
                    {
                        <p class="text-muted text-center">No has realizado ofertas aún</p>
                    }
                </div>
            </div>

            <!-- Modal para nueva oferta -->
            <div class="modal fade" id="offerModal" tabindex="-1">
                <div class="modal-dialog">
                    <div class="modal-content">
                        <div class="modal-header">
                            <h5 class="modal-title">Nueva Oferta</h5>
                            <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                        </div>
                        <form asp-action="MakeOffer" method="post">
                            <div class="modal-body">
                                <input type="hidden" name="propertyId" value="@Model.Id" />
                                <div class="mb-3">
                                    <label class="form-label">Monto de la oferta (RD$)</label>
                                    <input type="number" name="amount" class="form-control"
                                           placeholder="Ingresa el monto" min="1" required />
                                </div>
                            </div>
                            <div class="modal-footer">
                                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancelar</button>
                                <button type="submit" class="btn btn-success">
                                    <i class="fas fa-tag me-1"></i>Enviar Oferta
                                </button>
                            </div>
                        </form>
                    </div>
                </div>
            </div>
        }
    </div>
</div>

<a asp-action="Index" class="btn btn-secondary mt-3">
    <i class="fas fa-arrow-left me-2"></i>Volver
</a>

@section Scripts {
    <script>
        var chatBox = document.getElementById('chatBox');
        if (chatBox) chatBox.scrollTop = chatBox.scrollHeight;
    </script>
}