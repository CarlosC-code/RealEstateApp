@{
    ViewData["Title"] = "Error";
}

<div class="text-center mt-5">
    <i class="fas fa-exclamation-triangle fa-5x text-danger mb-3"></i>
    <h1 class="text-danger">Ocurrió un error</h1>
    <p class="text-muted">Lo sentimos, algo salió mal. Por favor intenta de nuevo.</p>
    <a asp-controller="Home" asp-action="Index" class="btn btn-primary mt-3">
        <i class="fas fa-home me-2"></i>Ir al Inicio
    </a>
</div>