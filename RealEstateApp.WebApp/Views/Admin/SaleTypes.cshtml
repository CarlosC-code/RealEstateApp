@model List<RealEstateApp.Core.Application.Dtos.SaleType.SaleTypeDto>

@{
    ViewData["Title"] = "Tipos de Ventas";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h2><i class="fas fa-tag me-2"></i>Tipos de Ventas</h2>
    <div class="d-flex gap-2">
        <a asp-action="CreateSaleType" class="btn btn-primary">
            <i class="fas fa-plus me-1"></i>Nuevo Tipo
        </a>
        <a asp-action="Index" class="btn btn-secondary">
            <i class="fas fa-arrow-left me-1"></i>Volver
        </a>
    </div>
</div>

<div class="card shadow">
    <div class="card-body">
        <table class="table table-hover">
            <thead class="table-dark">
                <tr>
                    <th>Nombre</th>
                    <th>Descripción</th>
                    <th>Propiedades</th>
                    <th>Acciones</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var type in Model)
                {
                    <tr>
                        <td>@type.Name</td>
                        <td>@type.Description</td>
                        <td>@type.PropertyCount</td>
                        <td>
                            <a asp-action="EditSaleType" asp-route-id="@type.Id" class="btn btn-primary btn-sm">
                                <i class="fas fa-edit me-1"></i>Editar
                            </a>
                            <a asp-action="DeleteSaleType" asp-route-id="@type.Id" class="btn btn-danger btn-sm">
                                <i class="fas fa-trash me-1"></i>Eliminar
                            </a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>