@model List<RealEstateApp.Core.Application.Dtos.Admin.ClientListDto>

@{
    ViewData["Title"] = "Clientes";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h2><i class="fas fa-users me-2"></i>Clientes</h2>
    <a asp-action="Index" class="btn btn-secondary">
        <i class="fas fa-arrow-left me-1"></i>Volver
    </a>
</div>

<div class="card shadow">
    <div class="card-body">
        <table class="table table-hover">
            <thead class="table-dark">
                <tr>
                    <th>Nombre</th>
                    <th>Usuario</th>
                    <th>Correo</th>
                    <th>Estado</th>
                    <th>Acciones</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var client in Model)
                {
                    <tr>
                        <td>@client.FullName</td>
                        <td>@client.UserName</td>
                        <td>@client.Email</td>
                        <td>
                            <span class="badge @(client.IsActive ? "bg-success" : "bg-danger")">
                                @(client.IsActive ? "Activo" : "Inactivo")
                            </span>
                        </td>
                        <td>
                            <a asp-action="ToggleClientStatus" asp-route-id="@client.Id"
                               class="btn btn-sm @(client.IsActive ? "btn-warning" : "btn-success")">
                                <i class="fas @(client.IsActive ? "fa-ban" : "fa-check") me-1"></i>
                                @(client.IsActive ? "Inactivar" : "Activar")
                            </a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>