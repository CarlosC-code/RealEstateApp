@model RealEstateApp.Core.Application.Dtos.Admin.DashboardDto

@{
    ViewData["Title"] = "Dashboard";
}

<h2 class="mb-4"><i class="fas fa-tachometer-alt me-2"></i>Dashboard</h2>

<div class="row g-4 mb-4">
    <div class="col-md-4">
        <div class="card bg-primary text-white shadow">
            <div class="card-body">
                <div class="d-flex justify-content-between">
                    <div>
                        <h6>Propiedades disponibles</h6>
                        <h2>@Model.AvailableProperties</h2>
                    </div>
                    <i class="fas fa-home fa-3x opacity-50"></i>
                </div>
                <small>Total: @Model.TotalProperties | Vendidas: @Model.SoldProperties</small>
            </div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="card bg-success text-white shadow">
            <div class="card-body">
                <div class="d-flex justify-content-between">
                    <div>
                        <h6>Agentes activos</h6>
                        <h2>@Model.ActiveAgents</h2>
                    </div>
                    <i class="fas fa-user-tie fa-3x opacity-50"></i>
                </div>
                <small>Inactivos: @Model.InactiveAgents</small>
            </div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="card bg-info text-white shadow">
            <div class="card-body">
                <div class="d-flex justify-content-between">
                    <div>
                        <h6>Clientes activos</h6>
                        <h2>@Model.ActiveClients</h2>
                    </div>
                    <i class="fas fa-users fa-3x opacity-50"></i>
                </div>
                <small>Inactivos: @Model.InactiveClients</small>
            </div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="card bg-warning text-white shadow">
            <div class="card-body">
                <div class="d-flex justify-content-between">
                    <div>
                        <h6>Desarrolladores activos</h6>
                        <h2>@Model.ActiveDevelopers</h2>
                    </div>
                    <i class="fas fa-code fa-3x opacity-50"></i>
                </div>
                <small>Inactivos: @Model.InactiveDevelopers</small>
            </div>
        </div>
    </div>
</div>

<div class="row g-3">
    <div class="col-md-4">
        <a asp-action="Agents" class="btn btn-outline-primary w-100 py-3">
            <i class="fas fa-user-tie fa-2x d-block mb-2"></i>Gestionar Agentes
        </a>
    </div>
    <div class="col-md-4">
        <a asp-action="Admins" class="btn btn-outline-success w-100 py-3">
            <i class="fas fa-user-shield fa-2x d-block mb-2"></i>Gestionar Administradores
        </a>
    </div>
    <div class="col-md-4">
        <a asp-action="Developers" class="btn btn-outline-warning w-100 py-3">
            <i class="fas fa-code fa-2x d-block mb-2"></i>Gestionar Desarrolladores
        </a>
    </div>
    <div class="col-md-4">
        <a asp-action="PropertyTypes" class="btn btn-outline-info w-100 py-3">
            <i class="fas fa-building fa-2x d-block mb-2"></i>Tipos de Propiedades
        </a>
    </div>
    <div class="col-md-4">
        <a asp-action="SaleTypes" class="btn btn-outline-secondary w-100 py-3">
            <i class="fas fa-tag fa-2x d-block mb-2"></i>Tipos de Ventas
        </a>
    </div>
    <div class="col-md-4">
        <a asp-action="Improvements" class="btn btn-outline-dark w-100 py-3">
            <i class="fas fa-tools fa-2x d-block mb-2"></i>Mejoras
        </a>
    </div>
    <div class="col-md-4">
        <a asp-action="Clients" class="btn btn-outline-info w-100 py-3">
            <i class="fas fa-users fa-2x d-block mb-2"></i>Gestionar Clientes
        </a>
    </div>
</div>