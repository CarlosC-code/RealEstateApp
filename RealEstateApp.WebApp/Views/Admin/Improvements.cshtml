@model List<RealEstateApp.Core.Application.Dtos.Improvement.ImprovementDto>

@{
    ViewData["Title"] = "Mejoras";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h2><i class="fas fa-tools me-2"></i>Mejoras</h2>
    <div class="d-flex gap-2">
        <a asp-action="CreateImprovement" class="btn btn-primary">
            <i class="fas fa-plus me-1"></i>Nueva Mejora
        </a>
        <a asp-action="Index" class="btn btn-secondary">
            <i class="fas fa-arrow-left me-1"></i>Volver
        </a>
    </div>
</div>

<div class="card shadow">
    <div class="card-body">
        <table class="table table-hover">
            <thead class="table-dark">
                <tr>
                    <th>Nombre</th>
                    <th>Descripción</th>
                    <th>Acciones</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var improvement in Model)
                {
                    <tr>
                        <td>@improvement.Name</td>
                        <td>@improvement.Description</td>
                        <td>
                            <a asp-action="EditImprovement" asp-route-id="@improvement.Id" class="btn btn-primary btn-sm">
                                <i class="fas fa-edit me-1"></i>Editar
                            </a>
                            <a asp-action="DeleteImprovement" asp-route-id="@improvement.Id" class="btn btn-danger btn-sm">
                                <i class="fas fa-trash me-1"></i>Eliminar
                            </a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>