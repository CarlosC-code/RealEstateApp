@{
    ViewData["Title"] = "Chat con Cliente";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h2><i class="fas fa-comments me-2"></i>Chat con @ViewBag.ClientName</h2>
    <a asp-controller="Home" asp-action="Detail" asp-route-id="@ViewBag.Property.Id" class="btn btn-secondary">
        <i class="fas fa-arrow-left me-1"></i>Volver
    </a>
</div>

<div class="card shadow-sm">
    <div class="card-header bg-primary text-white">
        <i class="fas fa-home me-2"></i>@ViewBag.Property.PropertyTypeName - Código: @ViewBag.Property.Code
    </div>
    <div class="card-body p-2">
        <div style="height:400px;overflow-y:auto;" class="mb-2 p-2" id="chatBox">
            @if (ViewBag.Messages != null)
            {
                @foreach (var msg in ViewBag.Messages)
                {
                    <div class="d-flex @(msg.IsFromClient ? "justify-content-start" : "justify-content-end") mb-2">
                        <div class="p-2 rounded @(msg.IsFromClient ? "bg-light" : "bg-primary text-white")"
                             style="max-width:80%;font-size:0.85rem;">
                            <p class="mb-0">@msg.Message</p>
                            <small class="@(msg.IsFromClient ? "text-muted" : "text-white-50")">
                                @msg.SentAt.ToString("hh:mm tt")
                            </small>
                        </div>
                    </div>
                }
            }
        </div>
        <form asp-action="SendMessageToClient" method="post">
            <input type="hidden" name="propertyId" value="@ViewBag.Property.Id" />
            <input type="hidden" name="clientId" value="@ViewBag.ClientId" />
            <div class="input-group">
                <input type="text" name="message" class="form-control"
                       placeholder="Escribe tu respuesta..." required />
                <button type="submit" class="btn btn-primary">
                    <i class="fas fa-paper-plane"></i>
                </button>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <script>
        var chatBox = document.getElementById('chatBox');
        if (chatBox) chatBox.scrollTop = chatBox.scrollHeight;
    </script>
}