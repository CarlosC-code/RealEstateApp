@{
    ViewData["Title"] = "Mis Chats";
}
<div class="d-flex justify-content-between align-items-center mb-4">
    <h2><i class="fas fa-comments me-2"></i>Mis Chats</h2>
    <a asp-action="Index" class="btn btn-secondary">
        <i class="fas fa-arrow-left me-1"></i>Volver
    </a>
</div>

@if (ViewBag.Conversations == null || !((IEnumerable<dynamic>)ViewBag.Conversations).Any())
{
    <div class="text-center mt-5">
        <i class="fas fa-comments fa-5x text-muted mb-3"></i>
        <h4 class="text-muted">No tienes conversaciones aún</h4>
    </div>
}
else
{
    <div class="row">
        @foreach (var conversation in ViewBag.Conversations)
        {
            <div class="col-md-6 mb-4">
                <div class="card shadow-sm">
                    <div class="card-header bg-primary text-white">
                        <i class="fas fa-home me-2"></i>@conversation.PropertyType - Código: @conversation.PropertyCode
                        <span class="float-end">
                            <i class="fas fa-user me-1"></i>@conversation.ClientName
                        </span>
                    </div>
                    <div class="card-body p-2">
                        <div style="height:200px;overflow-y:auto;" class="mb-2 p-2">
                            @foreach (var msg in conversation.Messages)
                            {
                                <div class="d-flex @(msg.IsFromClient ? "justify-content-start" : "justify-content-end") mb-2">
                                    <div class="p-2 rounded @(msg.IsFromClient ? "bg-light" : "bg-primary text-white")"
                                         style="max-width:80%;font-size:0.85rem;">
                                        <p class="mb-0">@msg.Message</p>
                                        <small class="@(msg.IsFromClient ? "text-muted" : "text-white-50")">
                                            @msg.SentAt.ToString("hh:mm tt")
                                        </small>
                                    </div>
                                </div>
                            }
                        </div>
                        <form asp-action="ReplyChat" method="post">
                            <input type="hidden" name="propertyId" value="@conversation.PropertyId" />
                            <input type="hidden" name="clientId" value="@conversation.ClientId" />
                            <div class="input-group">
                                <input type="text" name="message" class="form-control form-control-sm"
                                       placeholder="Escribe tu respuesta..." required />
                                <button type="submit" class="btn btn-primary btn-sm">
                                    <i class="fas fa-paper-plane"></i>
                                </button>
                            </div>
                        </form>
                    </div>
                </div>
            </div>
        }
    </div>
}