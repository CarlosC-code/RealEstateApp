@model RealEstateApp.Core.Application.Dtos.Property.PropertyDto

@{
    ViewData["Title"] = "Crear Propiedad";
}

<div class="card shadow p-4">
    <h3 class="mb-4"><i class="fas fa-home me-2"></i>Crear Propiedad</h3>

    @if (!ViewData.ModelState.IsValid)
    {
        <div class="alert alert-danger">
            @foreach (var error in ViewData.ModelState.Values.SelectMany(v => v.Errors))
            {
                <p class="mb-0">@error.ErrorMessage</p>
            }
        </div>
    }

    <form asp-action="CreateProperty" method="post" enctype="multipart/form-data">
        <div class="row">
            <div class="col-md-6 mb-3">
                <label class="form-label">Tipo de Propiedad</label>
                <select name="PropertyTypeId" class="form-select">
                    @foreach (var type in ViewBag.PropertyTypes)
                    {
                        <option value="@type.Id">@type.Name</option>
                    }
                </select>
            </div>
            <div class="col-md-6 mb-3">
                <label class="form-label">Tipo de Venta</label>
                <select name="SaleTypeId" class="form-select">
                    @foreach (var type in ViewBag.SaleTypes)
                    {
                        <option value="@type.Id">@type.Name</option>
                    }
                </select>
            </div>
        </div>
        <div class="row">
            <div class="col-md-4 mb-3">
                <label asp-for="Price" class="form-label">Precio (RD$)</label>
                <input asp-for="Price" type="number" class="form-control" />
                <span asp-validation-for="Price" class="text-danger"></span>
            </div>
            <div class="col-md-4 mb-3">
                <label asp-for="LandSize" class="form-label">Tamaño (mt²)</label>
                <input asp-for="LandSize" type="number" class="form-control" />
                <span asp-validation-for="LandSize" class="text-danger"></span>
            </div>
            <div class="col-md-2 mb-3">
                <label asp-for="Bedrooms" class="form-label">Habitaciones</label>
                <input asp-for="Bedrooms" type="number" class="form-control" />
                <span asp-validation-for="Bedrooms" class="text-danger"></span>
            </div>
            <div class="col-md-2 mb-3">
                <label asp-for="Bathrooms" class="form-label">Baños</label>
                <input asp-for="Bathrooms" type="number" class="form-control" />
                <span asp-validation-for="Bathrooms" class="text-danger"></span>
            </div>
        </div>
        <div class="mb-3">
            <label asp-for="Description" class="form-label">Descripción</label>
            <textarea asp-for="Description" class="form-control" rows="3"></textarea>
            <span asp-validation-for="Description" class="text-danger"></span>
        </div>
        <div class="mb-3">
            <label class="form-label">Mejoras</label>
            <div class="row">
                @foreach (var improvement in ViewBag.Improvements)
                {
                    <div class="col-md-3">
                        <div class="form-check">
                            <input type="checkbox" name="ImprovementIds" value="@improvement.Id"
                                   class="form-check-input" />
                            <label class="form-check-label">@improvement.Name</label>
                        </div>
                    </div>
                }
            </div>
        </div>
        <div class="mb-3">
            <label class="form-label">Imágenes (mínimo 1, máximo 4)</label>
            <input type="file" name="images" class="form-control" multiple accept="image/*" />
        </div>
        <div class="d-flex gap-2">
            <a asp-action="Properties" class="btn btn-secondary">
                <i class="fas fa-arrow-left me-1"></i>Volver
            </a>
            <button type="submit" class="btn btn-primary">
                <i class="fas fa-save me-1"></i>Crear
            </button>
        </div>
    </form>
</div>