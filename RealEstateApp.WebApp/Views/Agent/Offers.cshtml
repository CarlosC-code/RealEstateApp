@{
    ViewData["Title"] = "Ofertas";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h2><i class="fas fa-tag me-2"></i>Ofertas - @ViewBag.Property.PropertyTypeName - Código: @ViewBag.Property.Code</h2>
    <a asp-action="Index" class="btn btn-secondary">
        <i class="fas fa-arrow-left me-1"></i>Volver
    </a>
</div>

@if (ViewBag.Offers == null || !((IEnumerable<dynamic>)ViewBag.Offers).Any())
{
    <div class="text-center mt-5">
        <i class="fas fa-tag fa-5x text-muted mb-3"></i>
        <h4 class="text-muted">No hay ofertas para esta propiedad</h4>
    </div>
}
else
{
    <div class="card shadow">
        <div class="card-body">
            <table class="table table-hover">
                <thead class="table-dark">
                    <tr>
                        <th>Cliente</th>
                        <th>Monto</th>
                        <th>Fecha</th>
                        <th>Estado</th>
                        <th>Acciones</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var offer in ViewBag.Offers)
                    {
                        <tr>
                            <td>@offer.ClientName</td>
                            <td>RD$ @offer.Amount.ToString("N2")</td>
                            <td>@offer.OfferDate.ToString("dd/MM/yyyy hh:mm tt")</td>
                            <td>
                                <span class="badge @(offer.Status == "Accepted" ? "bg-success" : offer.Status == "Rejected" ? "bg-danger" : "bg-warning")">
                                    @(offer.Status == "Accepted" ? "Aceptada" : offer.Status == "Rejected" ? "Rechazada" : "Pendiente")
                                </span>
                            </td>
                            <td>
                                @if (offer.Status == "Pending")
                                {
                                    <form asp-action="AcceptOffer" method="post" class="d-inline">
                                        <input type="hidden" name="offerId" value="@offer.Id" />
                                        <input type="hidden" name="propertyId" value="@offer.PropertyId" />
                                        <button type="submit" class="btn btn-success btn-sm">
                                            <i class="fas fa-check me-1"></i>Aceptar
                                        </button>
                                    </form>
                                    <form asp-action="RejectOffer" method="post" class="d-inline">
                                        <input type="hidden" name="offerId" value="@offer.Id" />
                                        <input type="hidden" name="propertyId" value="@offer.PropertyId" />
                                        <button type="submit" class="btn btn-danger btn-sm">
                                            <i class="fas fa-times me-1"></i>Rechazar
                                        </button>
                                    </form>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
}