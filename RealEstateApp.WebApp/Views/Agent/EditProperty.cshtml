@model RealEstateApp.Core.Application.Dtos.Property.PropertyDto
@{
    ViewData["Title"] = "Editar Propiedad";
}

<div class="card shadow p-4">
    <h3 class="mb-4"><i class="fas fa-edit me-2"></i>Editar Propiedad</h3>

    @if (Model.Images != null && Model.Images.Any())
    {
        <div class="mb-3">
            <label class="form-label">Imágenes actuales</label>
            <div class="d-flex gap-2 flex-wrap">
                @foreach (var image in Model.Images)
                {
                    <div class="position-relative">
                        <img src="@image" style="height:100px;width:100px;object-fit:cover;" class="rounded border" alt="Imagen" />
                        <form asp-controller="Agent" asp-action="DeleteImage" method="post">
                            <input type="hidden" name="propertyId" value="@Model.Id" />
                            <input type="hidden" name="imageUrl" value="@image" />
                            <button type="submit" class="btn btn-danger btn-sm position-absolute top-0 end-0" style="padding:2px 6px;">
                                <i class="fas fa-times"></i>
                            </button>
                        </form>
                    </div>
                }
            </div>
        </div>
    }

    <form asp-action="EditProperty" asp-route-id="@Model.Id" method="post" enctype="multipart/form-data">
        <div class="row">
            <div class="col-md-6 mb-3">
                <label class="form-label">Tipo de Propiedad</label>
                <select name="PropertyTypeId" class="form-select">
                    @foreach (var type in ViewBag.PropertyTypes)
                    {
                        if (type.Id == Model.PropertyTypeId)
                        {
                            <option value="@type.Id" selected>@type.Name</option>
                        }
                        else
                        {
                            <option value="@type.Id">@type.Name</option>
                        }
                    }
                </select>
            </div>
            <div class="col-md-6 mb-3">
                <label class="form-label">Tipo de Venta</label>
                <select name="SaleTypeId" class="form-select">
                    @foreach (var type in ViewBag.SaleTypes)
                    {
                        if (type.Id == Model.SaleTypeId)
                        {
                            <option value="@type.Id" selected>@type.Name</option>
                        }
                        else
                        {
                            <option value="@type.Id">@type.Name</option>
                        }
                    }
                </select>
            </div>
        </div>
        <div class="row">
            <div class="col-md-4 mb-3">
                <label asp-for="Price" class="form-label">Precio (RD$)</label>
                <input asp-for="Price" type="number" class="form-control" />
            </div>
            <div class="col-md-4 mb-3">
                <label asp-for="LandSize" class="form-label">Tamaño (mt²)</label>
                <input asp-for="LandSize" type="number" class="form-control" />
            </div>
            <div class="col-md-2 mb-3">
                <label asp-for="Bedrooms" class="form-label">Habitaciones</label>
                <input asp-for="Bedrooms" type="number" class="form-control" />
            </div>
            <div class="col-md-2 mb-3">
                <label asp-for="Bathrooms" class="form-label">Baños</label>
                <input asp-for="Bathrooms" type="number" class="form-control" />
            </div>
        </div>
        <div class="mb-3">
            <label asp-for="Description" class="form-label">Descripción</label>
            <textarea asp-for="Description" class="form-control" rows="3"></textarea>
        </div>
        <div class="mb-3">
            <label class="form-label">Mejoras</label>
            <div class="row">
                @foreach (var improvement in ViewBag.Improvements)
                {
                    <div class="col-md-3">
                        <div class="form-check">
                            @if (Model.ImprovementIds != null && Model.ImprovementIds.Contains(improvement.Id))
                            {
                                <input type="checkbox" name="ImprovementIds" value="@improvement.Id" class="form-check-input" checked />
                            }
                            else
                            {
                                <input type="checkbox" name="ImprovementIds" value="@improvement.Id" class="form-check-input" />
                            }
                            <label class="form-check-label">@improvement.Name</label>
                        </div>
                    </div>
                }
            </div>
        </div>
        <div class="mb-3">
            <label class="form-label">Nuevas imágenes (opcional)</label>
            <input type="file" name="images" class="form-control" multiple accept="image/*" />
        </div>
        <div class="d-flex gap-2">
            <a asp-action="Properties" class="btn btn-secondary">
                <i class="fas fa-arrow-left me-1"></i>Volver
            </a>
            <button type="submit" class="btn btn-primary">
                <i class="fas fa-save me-1"></i>Guardar
            </button>
        </div>
    </form>
</div>